# Application Configuration
APP_NAME="AI-Powered LMS & Course Builder"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db

# Fallback option for local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./lms.db

# Primary LLM API Configuration (Google Gemini)
# Leave empty to use the grounded deterministic generator
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Secondary Provider (OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
